# Server only. Create .env.local locally; configure these in your hosting provider.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=atelier
# At least 32 random characters. Rotating credentials revokes existing sessions.
ADMIN_AUTH_SECRET=
INITIAL_ADMIN_EMAIL=
# Prefer hash generated by: npm run admin:password (reads password from stdin)
INITIAL_ADMIN_PASSWORD_HASH=
# Bootstrap alternative; do not set both password and hash.
INITIAL_ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
# Configure Resend webhook to POST /api/webhooks/resend for delivered/bounced events.
RESEND_WEBHOOK_SECRET=
# Random secret for Vercel Schedule Authorization: Bearer header
CRON_SECRET=
# Optional initial hero configuration; CMS publication overrides these.
NEXT_PUBLIC_HERO_VIDEO_URL=/videos/atelier-wall-printing-hero.mp4
NEXT_PUBLIC_HERO_POSTER_URL=/images/atelier-wall-printing-poster.webp
